# 复制本文件为 .env 并按实际环境修改。所有后端服务都从仓库根目录读取 .env。

# ---- 必填 ----
# 令牌签名密钥，所有服务必须相同。可用 python -c "import secrets; print(secrets.token_hex(32))" 生成
SECRET_KEY=
# 登录密码
ADMIN_PASSWORD=

# ---- 登录 ----
ADMIN_USERNAME=admin
# 登录有效期（小时）
TOKEN_TTL_HOURS=12

# ---- 网络 ----
# 默认只监听本机，由 Nginx 对外提供服务。确需局域网直连时才改为 0.0.0.0
BIND_HOST=127.0.0.1
TASK_SERVICE_PORT=5001
FILE_SERVICE_PORT=5002
LLM_SERVICE_PORT=8999
AMESIM_SERVICE_PORT=5003

# ---- 数据与存储 ----
# 允许访问的试验数据根目录，多个用分号（Windows）或冒号（Linux）分隔。
# 前端填写的数据目录必须位于这些目录之内。相对路径相对于仓库根目录。
DATA_ROOTS=pump_test_bench/samples
DB_PATH=pump_test_bench/data/tasks.db
LOG_DIR=logs
AMESIM_MODEL_DIR=AMESim_server/model

# ---- 大模型（Ollama） ----
OLLAMA_URL=http://127.0.0.1:11439
OLLAMA_MODEL=DeepSeek-R1-Distill-Qwen-1.5B
OLLAMA_TIMEOUT=300
# 单个文件最多分析的窗口数，超过时自动加大步长
LLM_MAX_WINDOWS=50
# 可选：配置后大模型会话存到 Redis，否则保存在服务进程内存中
REDIS_URL=
