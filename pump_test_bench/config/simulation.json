{
  "_说明": "仿真模型（健康参考模型）配置：模型输入是操作人员设定的工况，输出是该工况下健康系统各测点的预期值。离线把模型在工况网格上算一遍得到“仿真基准表”，在线诊断时按实测工况插值，不需要每次运行模型。修改后用 tools/build_simulation_table 或前端“仿真模型”页重建基准表。",

  "model": {
    "_说明": "type：surrogate = 数据代理模型（由正常数据拟合，AMESim 接入前用于跑通系统）；amesim = AMESim 模型（需配置下方 amesim 段并启动 AMESim 服务）",
    "type": "surrogate"
  },

  "inputs": [
    {"name": "电传转速", "column": "电传实际转速", "unit": "rpm", "grid": [1000, 1500, 2000, 2500, 3000]},
    {"name": "进口压力", "column": "P1进口压力", "unit": "MPa", "grid": [0.10, 0.15, 0.25]},
    {"name": "油温", "column": "供油温度1-1", "fallback_columns": ["供油温度1-2"], "unit": "℃", "grid": [15, 27, 37, 46],
     "valid": [-40, 120]}
  ],

  "outputs": [
    {"name": "系统流量", "unit": "L/h", "kind": "flow", "system": true,
     "columns": ["供油流量1-1", "供油流量1-2", "齿轮流量计", "回油流量1-1", "回油流量1-2"]},
    {"name": "回油质量流量", "unit": "kg/h", "kind": "flow", "columns": ["回油质量流量2"]},
    {"name": "低压压力", "unit": "MPa", "kind": "pressure", "flow_dependent": true, "columns": ["P5低压压力"]},
    {"name": "定压压力", "unit": "MPa", "kind": "pressure", "flow_dependent": true, "columns": ["P6定压压力"]},
    {"name": "回油压力", "unit": "MPa", "kind": "pressure", "flow_dependent": true, "columns": ["回油压力1-2"]},
    {"name": "供油压力", "unit": "MPa", "kind": "pressure", "columns": ["供油压力1-1", "供油压力1-2"]},
    {"name": "控制腔压力", "unit": "MPa", "kind": "pressure", "columns": ["P9控制腔压力"]},
    {"name": "电传扭矩", "unit": "N·m", "kind": "torque", "columns": ["电传扭矩"]}
  ],

  "thresholds": {
    "_说明": "实测与模型预期的相对偏差（扣除标定得到的固有偏差后）。阈值 = max(下限, 倍数 × 标定离散)",
    "sigma_warn": 3, "sigma_alarm": 5,
    "floor_warn": {"flow": 0.025, "pressure": 0.04, "torque": 0.15},
    "floor_alarm": {"flow": 0.04, "pressure": 0.07, "torque": 0.25},
    "system_min_columns": 4,
    "pressure_consistency": 0.5
  },

  "amesim": {
    "_说明": "接入 AMESim 时填写：模型文件放在 AMESim 服务的模型目录；parameters 说明每个输入怎样设置到模型，variables 给出每个输出对应的模型变量路径（一个输出可对应同一点的多只表）。以下 ordiam 档位表沿用原前端配置",
    "url": "http://127.0.0.1:5003",
    "model_file": "待填写.ame",
    "stop_time_s": 20,
    "steady_tail_s": 5,
    "parameters": [
      {"input": "电传转速", "kind": "input_table", "points": 150},
      {"input": "电传转速", "kind": "component", "params": ["ordiam@flowcontrol01", "ordiam@flowcontrol01_1", "ordiam@flowcontrol01_2"],
       "lookup": {"1000": [2, 2, 2], "1500": [3, 5, 5], "2000": [7, 10, 10], "2500": [7, 7, 10], "3000": [6.5, 7, 7]}},
      {"input": "进口压力", "kind": "component", "params": ["待填写@燃油泵或压力源"]},
      {"input": "油温", "kind": "global", "params": ["待填写_油温或粘度参数"]}
    ],
    "variables": {
      "系统流量": "待填写@供油流量变量",
      "回油质量流量": "待填写@质量流量变量",
      "低压压力": "待填写@P5",
      "定压压力": "待填写@P6",
      "回油压力": "待填写@回油压力",
      "供油压力": "待填写@供油压力",
      "控制腔压力": "待填写@P9",
      "电传扭矩": "待填写@扭矩"
    }
  }
}
