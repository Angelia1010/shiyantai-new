{
  "_说明": "温控链路模型：从冷热油汇流后的温度出发，给出循环油箱、供油、回油各点的健康温度（随流量变化）。加热器出口与冷水机温度在 30 秒的数据里还没到稳态，不作输入。负责发现没有配对的温度传感器偏差，以及汇流温度这个输入测点本身的偏差。",
  "id": "thermal",
  "name": "温控链路模型",
  "order": 3,
  "description": "管道式加热器、板式换热器、循环油箱：汇流温度、流量 → 油箱、供油、回油温度",
  "components": [
    "管道式加热器",
    "温控系统_板式换热器",
    "循环油箱"
  ],
  "default_mode": "decisive",
  "engine": {
    "type": "surrogate"
  },
  "inputs": [
    {
      "name": "汇流温度",
      "column": "T9冷热油汇流后温度",
      "unit": "℃",
      "grid": [
        15,
        25,
        35,
        45,
        55
      ],
      "valid": [
        -40,
        120
      ],
      "_说明": "正常数据的汇流温度在 17–45 ℃；网格延到 55 ℃（外推），以便汇流温度传感器偏高时仍能看出各点温度对不上"
    },
    {
      "name": "流量",
      "columns": [
        "供油流量1-1",
        "供油流量1-2",
        "齿轮流量计",
        "回油流量1-1",
        "回油流量1-2"
      ],
      "aggregate": "median",
      "unit": "L/h",
      "grid": [
        150,
        300,
        450,
        550
      ],
      "valid": [
        10,
        20000
      ]
    }
  ],
  "outputs": [
    {
      "name": "循环油箱温度",
      "unit": "℃",
      "kind": "temperature",
      "residual": "absolute",
      "columns": [
        "T2循环油箱温度"
      ],
      "component": "循环油箱"
    },
    {
      "name": "供油温度",
      "unit": "℃",
      "kind": "temperature",
      "residual": "absolute",
      "columns": [
        "供油温度1-1",
        "供油温度1-2"
      ],
      "component": "供油管路"
    },
    {
      "name": "回油温度",
      "unit": "℃",
      "kind": "temperature",
      "residual": "absolute",
      "columns": [
        "回油温度1-1",
        "回油温度1-2"
      ],
      "component": "回油管路"
    }
  ],
  "rules": {
    "group_shift": {
      "outputs": [
        "循环油箱温度",
        "供油温度",
        "回油温度"
      ],
      "min_columns": 4,
      "meaning": "input",
      "input": "汇流温度",
      "component": "温控系统_板式换热器"
    }
  },
  "thresholds": {
    "sigma_warn": 3,
    "sigma_alarm": 5,
    "floor_warn": {
      "temperature": 3.0
    },
    "floor_alarm": {
      "temperature": 5.0
    }
  },
  "amesim": {
    "model_file": "待填写.ame",
    "parameters": [],
    "variables": {}
  }
}