{
  "_说明": "涡轮流量计模型（小流量管路）：自定义公式 Y = a + b·质量流量 + c·密度（用户回归结果：质量流量 kg/s、密度 kg/m³ 为核心变量，黏度 P 值远大于 0.05 已移除），输出该管路两只涡轮流量计的转速（Hz）。系数固定；可在页面上改为由数据拟合。入口压力、温度保留为变量，供 AMESim 部件模型或改写公式时使用。",
  "id": "turbine_small",
  "name": "涡轮流量计模型（小流量管路）",
  "order": 3,
  "description": "小流量管路两只涡轮流量计：质量流量（kg/s）、密度（kg/m³）→ 转速 Hz（自定义公式）",
  "components": [
    "回油流量计2"
  ],
  "default_mode": "decisive",
  "engine": {
    "type": "surrogate"
  },
  "active_if": [
    {
      "column": "回油流量2-1",
      "min": 5,
      "note": "小流量管路工作"
    }
  ],
  "inputs": [
    {
      "name": "入口压力",
      "column": "回油压力2-1",
      "unit": "MPa",
      "grid": [
        0.02,
        0.06,
        0.1,
        0.16
      ],
      "valid": [
        -0.5,
        40
      ]
    },
    {
      "name": "质量流量",
      "column": "回油质量流量1",
      "scale": 0.0002777777777777778,
      "unit": "kg/s",
      "valid": [
        1,
        20000
      ],
      "grid": [
        0.00139,
        0.00556,
        0.01111,
        0.01667,
        0.02222,
        0.02778
      ]
    },
    {
      "name": "温度",
      "column": "回油温度2-1",
      "fallback_columns": [
        "回油温度2-2"
      ],
      "unit": "℃",
      "grid": [
        15,
        25,
        35,
        45,
        50
      ],
      "valid": [
        -40,
        120
      ]
    },
    {
      "name": "密度",
      "derived": "density",
      "temperature_column": "回油温度2-1",
      "fallback_columns": [
        "回油温度2-2"
      ],
      "unit": "kg/m³",
      "grid": [
        770,
        780,
        790
      ]
    }
  ],
  "outputs": [
    {
      "name": "涡轮流量计转速",
      "unit": "Hz",
      "kind": "flow",
      "columns": [
        "回油流量2-1转速",
        "回油流量2-2转速"
      ],
      "component": "回油流量计2",
      "system": "回油系统（小流量管路）",
      "method": "formula",
      "formula": {
        "expression": "a + b * 质量流量 + c * 密度",
        "coefficients": {
          "a": {
            "value": 934.79,
            "fit": false
          },
          "b": {
            "value": 13217.85,
            "fit": false
          },
          "c": {
            "value": -1.18,
            "fit": false
          }
        }
      }
    }
  ],
  "rules": {
    "group_shift": {
      "output": "涡轮流量计转速",
      "min_columns": 2,
      "meaning": "reference",
      "component": "回油流量计2"
    }
  },
  "thresholds": {
    "sigma_warn": 3,
    "sigma_alarm": 5,
    "floor_warn": {
      "flow": 0.02
    },
    "floor_alarm": {
      "flow": 0.035
    }
  },
  "media": {
    "video": "videos/涡轮流量计仿真2.mp4",
