{
  "_说明": "涡轮流量计模型：由正常数据拟合的数据代理模型，质量流量、燃油密度 → 各涡轮流量计应有的体积流量。负责发现单只或几只涡轮表的 K 系数漂移，以及参考量（质量流量计、燃油密度）的偏差。以后可改为 AMESim 涡轮流量计部件模型（补全 amesim 段）。",
  "id": "turbine",
  "name": "涡轮流量计模型",
  "order": 2,
  "description": "回路 1/2 流量计与供油管路上的涡轮流量计：质量流量、密度 → 预期体积流量",
  "components": [
    "回油流量计1",
    "回油流量计2",
    "供油管路"
  ],
  "default_mode": "decisive",
  "engine": {
    "type": "surrogate"
  },
  "inputs": [
    {
      "name": "质量流量",
      "column": "回油质量流量2",
      "unit": "kg/h",
      "grid": [
        100,
        150,
        200,
        250,
        300,
        350,
        400,
        450
      ],
      "valid": [
        20,
        20000
      ]
    },
    {
      "name": "燃油密度",
      "derived": "density",
      "temperature_column": "供油温度1-1",
      "fallback_columns": [
        "供油温度1-2"
      ],
      "unit": "kg/m³",
      "grid": [
        770,
        785,
        800,
        815,
        830
      ],
      "_说明": "由油温按燃油密度模型计算（诊断设置里填了 20 ℃ 密度时用它，否则用健康基准拟合的密度-温度关系）"
    }
  ],
  "outputs": [
    {
      "name": "预期体积流量",
      "unit": "L/h",
      "kind": "flow",
      "columns": [
        "回油流量1-1",
        "回油流量1-2",
        "供油流量1-1",
        "供油流量1-2"
      ],
      "component_by_column": {
        "回油流量1-1": "回油流量计1",
        "回油流量1-2": "回油流量计2",
        "供油流量1-1": "供油管路",
        "供油流量1-2": "供油管路"
      }
    }
  ],
  "rules": {
    "group_shift": {
      "output": "预期体积流量",
      "min_columns": 3,
      "meaning": "reference"
    }
  },
  "thresholds": {
    "sigma_warn": 3,
    "sigma_alarm": 5,
    "floor_warn": {
      "flow": 0.02
    },
    "floor_alarm": {
      "flow": 0.035
    }
  },
  "media": {
    "video": "videos/涡轮流量计仿真2.mp4",
    "caption": "涡轮流量计 AMESim 仿真录屏（示意），不随本次计算变化"
  },
  "amesim": {
    "_说明": "接入涡轮流量计的 AMESim 部件模型时填写，结构同 bench.json",
    "model_file": "待填写.ame",
    "parameters": [],
    "variables": {
      "预期体积流量": "待填写"
    }
  }
}